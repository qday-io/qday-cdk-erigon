# Copy this file to .env and adjust as needed:
#   cp env.example .env
#
# The values below are a sample from the 2026-10 qday2-testnet state-rollback incident
# (L1 virtual=4390 / verified=4387, local node rolled back to 4308).
# For another incident, recompute them using "Step 0" in README.md.

# Pre-built cdk-erigon image (required)
# Must be execution-compatible with the history that produced the chain.
# If no historical transaction touched a newly added precompile (such as 0x1000 PQCVERIFY),
# replaying with the s2 image matches the older binary.
CDK_ERIGON_IMAGE=ghcr.io/qday-io/qday-cdk-erigon:qday-v2.61.19-validium-s2

# External L1
L1_RPC_URL=http://host.docker.internal:1545
L1_CHAIN_ID=31337

# ---- L1 recovery switches ---------------------------------------------------
# L1 block to start scanning SequenceBatches events from (the rollup contract
# deployment block; same as zkevm.l1-first-block in dynamic-validium.yaml)
L1_SYNC_START_BLOCK=88224
# Stop recovery at this batch, as a verification gate. Set it to the latest
# virtual batch on L1. After verification, cutover sets this to 0 (do not stop;
# keep sequencing as a normal sequencer).
L1_SYNC_STOP_BATCH=4390
# Txpool wait while replaying empty blocks. 0s = do not wait (required during
# recovery; otherwise every empty block sleeps 250ms). cutover.sh restores
# 250ms on promotion so live block production does not emit empty blocks back-to-back.
SEQUENCER_TIMEOUT_ON_EMPTY_TX_POOL=0s

# ---- Recovery-node host ports (stay off the live 8545/6900 during recovery) -
RECOVER_RPC_PORT=8645
RECOVER_DATASTREAM_PORT=6901

# ---- Acceptance parameters (used by verify-recovery.sh) ---------------------
# Latest virtual batch on L1 (recovery target)
EXPECTED_BATCH=4390
# Anchor: latest L1-verified batch and its stateRoot.
# Taken from the L1 VerifyBatches event (this sample: L1 block 424456).
ANCHOR_BATCH=4387
ANCHOR_STATE_ROOT=0x898007fd4a43e2144f265225fbd256adb808e5cc0631b4a78726310d2ca09cf2
# A batch that was missing on the old node (the one that logged "no blocks found")
SPOT_CHECK_BATCH=4388
