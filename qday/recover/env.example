# Copy this file to .env and adjust as needed:
#   cp env.example .env
#
# 下列值以 2026-10 qday2-testnet 状态回滚事故为样例
# (L1 virtual=4390 / verified=4387,本地回滚到 4308)。
# 用于其他事故时,按 README.md "第 0 步" 的方法重新取值。

# Pre-built cdk-erigon image (required)
# 必须与产生链上历史的执行规则兼容;若历史中没有交易触及新增预编译
# (如 0x1000 PQCVERIFY),s2 与旧版重放结果一致
CDK_ERIGON_IMAGE=ghcr.io/qday-io/qday-cdk-erigon:qday-v2.61.19-validium-s2

# External L1
L1_RPC_URL=http://host.docker.internal:1545
L1_CHAIN_ID=31337

# ---- L1 recovery 开关 -------------------------------------------------------
# 从该 L1 块开始扫描 SequenceBatches 事件(= rollup 合约部署区块,
# 与 dynamic-validium.yaml 的 zkevm.l1-first-block 一致)
L1_SYNC_START_BLOCK=88224
# 恢复到该 batch 即停,作为验证关卡;= L1 上最新的 virtual batch。
# 验证通过、切换转正时改为 0(不停,继续当正常 sequencer)
L1_SYNC_STOP_BATCH=4390
# 空块重放时的交易池等待。0s = 不等待(恢复期间必须这样,否则每空块 250ms)。
# cutover.sh 转正时会把本项改回 250ms,避免正式出块时空块过密。
SEQUENCER_TIMEOUT_ON_EMPTY_TX_POOL=0s

# ---- 恢复节点端口(宿主机侧,恢复期间避开现役 8545/6900)--------------------
RECOVER_RPC_PORT=8645
RECOVER_DATASTREAM_PORT=6901

# ---- 验收参数(verify-recovery.sh 使用)--------------------------------------
# L1 上的最新 virtual batch(恢复目标)
EXPECTED_BATCH=4390
# 验收锚点:L1 已验证的最新 batch 及其 stateRoot
# 取自 L1 VerifyBatches 事件(本例:L1 块 424456)
ANCHOR_BATCH=4387
ANCHOR_STATE_ROOT=0x898007fd4a43e2144f265225fbd256adb808e5cc0631b4a78726310d2ca09cf2
# 抽查一个此前在旧节点上缺失的 batch(旧节点报 no blocks found 的那个)
SPOT_CHECK_BATCH=4388
