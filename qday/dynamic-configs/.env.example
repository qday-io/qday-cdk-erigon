# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Pre-built cdk-erigon image (required)
CDK_ERIGON_IMAGE=ghcr.io/qday-io/qday-cdk-erigon:qday-v2.61.19-validium

# Sequencer ports (host side)
SEQUENCER_RPC_PORT=8123
SEQUENCER_DATASTREAM_PORT=6900

# RPC node port (host side)
RPC_PORT=8124

# RPC node — sequencer datastream endpoint (<sequencer-host>:<datastream-port>)
# Used to SYNC blocks from the sequencer.
SEQUENCER_DATASTREAMER_URL=host.docker.internal:6900

# RPC node — sequencer HTTP RPC endpoint (http://<sequencer-host>:<rpc-port>)
# Used to FORWARD transactions (eth_sendRawTransaction) to the sequencer.
# Also used by the pool manager to forward queued txs to the sequencer.
SEQUENCER_RPC_URL=http://host.docker.internal:8123

# Tx pool manager (RPC node stack)
POOL_MANAGER_IMAGE=hermeznetwork/zkevm-pool-manager:v0.1.2
# URL the RPC node redirects eth_sendRawTransaction to (in-network)
POOL_MANAGER_URL=http://tx-pool-manager:8545
# Host port exposed for the pool manager JSON-RPC
POOL_MANAGER_PORT=8546

# Blockscout configuration is maintained in a separate repository.
# See: https://github.com/blockscout/blockscout
