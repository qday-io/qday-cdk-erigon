# Copy this file to .env and adjust as needed:
#   cp env.example .env

# Pre-built cdk-erigon image (required)
CDK_ERIGON_IMAGE=ghcr.io/qday-io/qday-cdk-erigon:qday-v2.61.19-sovereign

# ──────────────────────────────────────────────────────────────────────
# External L1 + cdk-node (deployed by other projects)
#
# This qday stack runs as a zkrollup that settles to an external L1 and is
# orchestrated by an external cdk-node. It does NOT run cdk-dac or AggLayer.
#
# L1 RPC endpoint + chain id (consumed by both sequencer and RPC node via
# compose command-line overrides; overrides the values in the yaml configs):
L1_RPC_URL=http://host.docker.internal:31337
L1_CHAIN_ID=31337
#
# The following are NOT env vars — they are deployment-specific constants that
# must be pasted into BOTH dynamic-validium.yaml and dynamic-validium-rpc.yaml
# from the external L1 deploy's deploy_output.json / create_rollup_output.json:
#   zkevm.address-sequencer          <- create_rollup_output.json -> sequencer
#   zkevm.address-zkevm              <- create_rollup_output.json -> rollupAddress
#   zkevm.address-rollup             <- deploy_output.json -> polygonRollupManagerAddress
#   zkevm.address-ger-manager        <- deploy_output.json -> polygonZkEVMGlobalExitRootAddress
#   zkevm.l1-matic-contract-address  <- L1 POL token contract
#   zkevm.l1-first-block             <- L1 block where the rollup starts
# ──────────────────────────────────────────────────────────────────────

# Sequencer ports (host side)
SEQUENCER_RPC_PORT=8545
SEQUENCER_DATASTREAM_PORT=6900

# RPC node port (host side)
RPC_PORT=8546

# RPC node — sequencer datastream endpoint (<sequencer-host>:<datastream-port>)
# Used to SYNC blocks from the sequencer.
SEQUENCER_DATASTREAMER_URL=host.docker.internal:6900

# RPC node — sequencer HTTP RPC endpoint (http://<sequencer-host>:<rpc-port>)
# Used to FORWARD transactions (eth_sendRawTransaction) to the sequencer.
# Also used by the pool manager to forward queued txs to the sequencer.
SEQUENCER_RPC_URL=http://host.docker.internal:8545

# Tx pool manager (RPC node stack)
POOL_MANAGER_IMAGE=hermeznetwork/zkevm-pool-manager:v0.1.2
# URL the RPC node redirects eth_sendRawTransaction to (in-network)
POOL_MANAGER_URL=http://tx-pool-manager:8545
# Host port exposed for the pool manager JSON-RPC
POOL_MANAGER_PORT=8547

# Blockscout configuration is maintained in a separate repository.
# See: https://github.com/blockscout/blockscout
