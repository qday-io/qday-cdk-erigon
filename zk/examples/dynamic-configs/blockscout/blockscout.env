# Blockscout backend — merged with docker-compose.rpc.yml + docker-compose.blockscout.yml
# RPC node is on the same compose network as service "rpc".

ETHEREUM_JSONRPC_VARIANT=erigon
ETHEREUM_JSONRPC_HTTP_URL=http://rpc:8124/
ETHEREUM_JSONRPC_TRACE_URL=http://rpc:8124/
ETHEREUM_JSONRPC_WS_URL=ws://rpc:8124/
ETHEREUM_JSONRPC_TRANSPORT=http

CHAIN_ID=44005
CHAIN_TYPE=default
NETWORK=QDay2 Testnet
SUBNETWORK=QDay2 Testnet
COIN=ETH
COIN_NAME=Ether

DISABLE_MARKET=true
DISABLE_FILE_LOGGING=false

# Sovereign L2 — no L1 bridge / batch L1 indexing
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=false

DATABASE_URL=postgresql://blockscout:blockscout@blockscout-db:5432/blockscout
SECRET_KEY_BASE=56NtB48ear7+wMSf0IQuWDAAazhpb31qyc7GiyspBP2vh7t5zlCsF5QDv76chXeN

PORT=4000
POOL_SIZE=40
POOL_SIZE_API=10
HEART_BEAT_TIMEOUT=30
