# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Pre-built cdk-erigon image (required)
CDK_ERIGON_IMAGE=ghcr.io/qday-io/qday-cdk-erigon:qday-v2.61.19-sovereign

# Sequencer ports (host side)
SEQUENCER_RPC_PORT=8123
SEQUENCER_DATASTREAM_PORT=6900

# RPC node port (host side)
RPC_PORT=8124
